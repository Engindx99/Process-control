{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "python.defaultInterpreterPath": "python",
    // =========================
    // UNICODE / TURKISH CHARACTER FIX (FIXES THE "BOX" ISSUE)
    // =========================
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.unicodeHighlight.allowedCharacters": {
        "ı": true,
        "ğ": true,
        "ü": true,
        "ş": true,
        "ö": true,
        "ç": true,
        "İ": true,
        "Ğ": true,
        "Ü": true,
        "Ş": true,
        "Ö": true,
        "Ç": true
    },
    // =========================
    // TERMINAL FIX (CRITICAL)
    // =========================
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.profiles.windows": {
        "Git Bash": {
            "path": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
            "args": [
                "--login",
                "-i"
            ]
        }
    },
    // =========================
    // CURSOR FIX
    // =========================
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "blink",
    // =========================
    // EDITOR BEHAVIOR
    // =========================
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    // =========================
    // WHITESPACE DEBUG (OPTIONAL BUT VERY USEFUL)
    // =========================
    "editor.renderWhitespace": "all",
    // =========================
    // FILE ENCODING (PREVENTS CORRUPTION)
    // =========================
    "files.encoding": "utf8",
    "files.autoGuessEncoding": true,
    // =========================
    // PYTHON QUALITY TOOLING
    // =========================
    "python.analysis.typeCheckingMode": "basic",
    "python.linting.enabled": true,
    "python.linting.ruffEnabled": true,
    "python.linting.mypyEnabled": false,
    "python.formatting.provider": "black",
    // =========================
    // PERFORMANCE / TRAINING FRIENDLINESS
    // =========================
    "terminal.integrated.env.windows": {
        "PYTHONUNBUFFERED": "1"
    },
    // =========================
    // PROJECT SAFETY
    // =========================
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true
    },
    // =========================
    // RL / ML LARGE PROJECT SUPPORT
    // =========================
    "python.analysis.extraPaths": [
        "./src"
    ],
    "files.watcherExclude": {
        "**/models/**": true,
        "**/data/**": true,
        "**/.git/objects/**": true
    }
}